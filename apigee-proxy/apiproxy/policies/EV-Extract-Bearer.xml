<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<ExtractVariables continueOnError="false" enabled="true" name="EV-Extract-Bearer">
  <DisplayName>EV-Extract-Bearer</DisplayName>
  <Header name="Authorization">
    <Pattern ignoreCase="true">Bearer {rawjwt}</Pattern>
  </Header>
  <IgnoreUnresolvedVariables>true</IgnoreUnresolvedVariables>
</ExtractVariables>
