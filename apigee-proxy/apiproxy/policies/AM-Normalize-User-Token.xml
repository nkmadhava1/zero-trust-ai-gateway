<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<AssignMessage continueOnError="false" enabled="true" name="AM-Normalize-User-Token">
  <DisplayName>AM-Normalize-User-Token</DisplayName>
  <Properties/>
  <Set>
    <Headers>
      <Header name="Authorization">{request.header.X-User-Token}</Header>
    </Headers>
  </Set>
  <IgnoreUnresolvedVariables>true</IgnoreUnresolvedVariables>
  <AssignTo createNew="false" transport="http" type="request"/>
</AssignMessage>
